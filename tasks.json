{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "server",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "server",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start TraceScope AI (Full Stack)",
      "dependsOn": ["Run Backend (FastAPI)", "Run Frontend (Vite)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
